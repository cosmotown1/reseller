{
  "name": "reseller",
  "version": "2.25.0",
  "private": true,
  "description": "Cosmotown Reseller API reference and documentation tooling",
  "license": "ISC",
  "scripts": {
    "docs:lint": "redocly lint openapi/openapi.yaml",
    "docs:build": "redocly build-docs openapi/openapi.yaml -o dist/index.html",
    "docs:postman": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && openapi2postmanv2 -s openapi/openapi.yaml -o dist/cosmotown-reseller-v2.25.postman_collection.json -p && node -e \"require('fs').statSync('dist/cosmotown-reseller-v2.25.postman_collection.json')\""
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "openapi-to-postmanv2": "^6.4.2"
  }
}
